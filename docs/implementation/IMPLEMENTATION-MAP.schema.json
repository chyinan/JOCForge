{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jocforge:implementation-map:v1",
  "type": "object",
  "$defs": {
    "direct_slice": {
      "type": "object",
      "required": ["slice_id", "mapping_status", "implementation_status", "scope", "implementation_files", "clock", "parameters", "test_modules", "vectors"],
      "properties": {
        "slice_id": {"type": "string", "minLength": 1},
        "mapping_status": {"type": "string", "minLength": 1},
        "implementation_status": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "owner": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "implementation_files": {"type": "array", "items": {"type": "string"}},
        "test_modules": {"type": "array", "items": {"type": "string"}},
        "clock": {"type": "object"},
        "parameters": {"type": "object"},
        "vectors": {"type": "object"},
        "not_run": {"type": "array", "items": {"type": "string"}},
        "implementation_inventory": {"type": "array"},
        "test_inventory": {"type": "array"}
      }
    },
    "programme_root": {
      "type": "object",
      "required": ["root_id", "materialization_status"],
      "properties": {
        "root_id": {"type": "string", "minLength": 1},
        "materialization_status": {"type": "string", "minLength": 1},
        "implementation_status": {"type": "string"},
        "implementation_files": {"type": "array", "items": {"type": "string"}},
        "test_modules": {"type": "array", "items": {"type": "string"}},
        "remaining_gates": {"type": "array", "items": {"type": "string"}},
        "canonical_gtc_state_ref_status": {"type": "string"},
        "gtc_owner_receipt_status": {"type": "string"},
        "gtc_single_root_swap_status": {"type": "string"},
        "encode_status": {"type": "string"}
      }
    }
  },
  "required": ["schema", "status", "functional_entries", "programme_roots", "selected_overlap_projection", "phase_one", "wash_supplement_registry"],
  "properties": {
    "schema": {"const": "jocforge-implementation-map.v1"},
    "public_distribution_authorization": {"type": "object"},
    "status": {
      "type": "object",
      "required": ["ARCHITECTURE_DESIGN", "TRACEABILITY", "P1.1"]
    },
    "functional_entries": {
      "type": "array",
      "minItems": 104,
      "maxItems": 104,
      "items": {
        "type": "object",
        "required": ["functional_id", "spec_files", "owner", "planned_phase", "inventory_status", "implementation_status"],
        "properties": {
          "direct_slices": {
            "type": "array",
            "items": {"$ref": "#/$defs/direct_slice"}
          }
        },
        "allOf": [{"if": {"required": ["active_slice_materialization"], "properties": {"active_slice_materialization": {"const": "MATERIALIZED"}}}, "then": {"required": ["implementation_files", "test_modules", "clock", "parameters", "vectors"]}}]
      }
    },
    "programme_roots": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/programme_root"}
    },
    "selected_overlap_projection": {"type": "object"},
    "phase_one": {"type": "object"},
    "approved_dependencies": {"type": "object"},
    "wash_supplement_registry": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "required": ["package_id", "relative_path", "manifest_sha256", "functional_ids", "local_verification", "evidence_class", "disposition", "not_run"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "functional_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "local_verification": {
            "type": "object",
            "required": ["python", "python_optimized"],
            "properties": {
              "python": {"const": "PASS"},
              "python_optimized": {"const": "PASS"}
            },
            "additionalProperties": false
          },
          "evidence_class": {"const": "WASHED_SUPPLEMENT_EVIDENCE_ONLY"},
          "disposition": {"type": "string", "minLength": 1},
          "not_run": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
