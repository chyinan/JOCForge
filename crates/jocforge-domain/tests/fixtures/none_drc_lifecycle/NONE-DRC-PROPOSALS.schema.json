{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "none-drc-owner-proposals.v1",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_proposal": {
      "type": "object",
      "required": ["schema", "source_index", "generation", "provider_sha256", "measurement_sha256", "shared_analysis_sha256", "before_sha256", "proposed_after_sha256", "rf_u16", "line_u16", "state_material_complete"],
      "properties": {
        "schema": {"const": "none-drc-source-proposal.v1"},
        "source_index": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 1},
        "provider_sha256": {"$ref": "#/$defs/sha"},
        "measurement_sha256": {"$ref": "#/$defs/sha"},
        "shared_analysis_sha256": {"$ref": "#/$defs/sha"},
        "before_sha256": {"$ref": "#/$defs/sha"},
        "proposed_after_sha256": {"$ref": "#/$defs/sha"},
        "rf_u16": {"type": "integer", "minimum": 0, "maximum": 65535},
        "line_u16": {"type": "array", "minItems": 6, "maxItems": 6},
        "state_material_complete": {"const": true}
      }
    }
  },
  "production_schema_status": "BLOCKED_UNTIL_SECONDARY_AND_WHOLE_SOURCE_EXECUTION"
}
