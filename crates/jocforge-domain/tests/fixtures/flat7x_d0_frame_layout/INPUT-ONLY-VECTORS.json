{
  "schema": "jocforge.flat7x_d0_six_block_layout.synthetic_input_only.v1",
  "contains_audio_or_pcm_bytes": false,
  "native_insertion_cursor_claim": "UNBOUND_CALLER_OWNED_OFFSET_ONLY",
  "cases": [
    {
      "id": "valid-single-block-two-field",
      "audio_block_bit_lengths": [8, 12, 20, 16, 24, 32],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 7, "payload_bytes": 1}
      ],
      "expected": {
        "status": "VALID_LAYOUT_PROPOSAL",
        "bsi_end_bit": 72,
        "skip_field_start_bit": 99,
        "skip_field_bit_length": 18,
        "total_frame_span_bits": 202,
        "target_frame_bytes": 4096
      }
    },
    {
      "id": "valid-u9-maximum-container",
      "audio_block_bit_lengths": [0, 0, 0, 0, 0, 0],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 0, "payload_bytes": 511}
      ],
      "expected": {
        "status": "VALID_LAYOUT_PROPOSAL",
        "bsi_end_bit": 72,
        "skip_field_start_bit": 72,
        "skip_field_bit_length": 4098,
        "total_frame_span_bits": 4170,
        "target_frame_bytes": 4096
      }
    },
    {
      "id": "reject-missing-block-two-field",
      "audio_block_bit_lengths": [1, 2, 3, 4, 5, 6],
      "skip_fields": [],
      "expected": {"status": "MISSING_BLOCK_TWO_SKIP_FIELD"}
    },
    {
      "id": "reject-duplicate-block-two-fields",
      "audio_block_bit_lengths": [1, 2, 3, 4, 5, 6],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 0, "payload_bytes": 1},
        {"block_index": 2, "insertion_offset_bits": 1, "payload_bytes": 2}
      ],
      "expected": {"status": "DUPLICATE_BLOCK_TWO_SKIP_FIELDS"}
    },
    {
      "id": "reject-field-outside-block-two",
      "audio_block_bit_lengths": [1, 2, 3, 4, 5, 6],
      "skip_fields": [
        {"block_index": 1, "insertion_offset_bits": 0, "payload_bytes": 1}
      ],
      "expected": {"status": "SKIP_FIELD_ON_NON_BLOCK_TWO", "block_index": 1}
    },
    {
      "id": "reject-caller-insertion-outside-block-two-span",
      "audio_block_bit_lengths": [1, 2, 4, 4, 5, 6],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 5, "payload_bytes": 1}
      ],
      "expected": {"status": "INSERTION_POINT_OUTSIDE_AUDIO_SPAN"}
    },
    {
      "id": "reject-u9-overflow-container",
      "audio_block_bit_lengths": [0, 0, 0, 0, 0, 0],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 0, "payload_bytes": 512}
      ],
      "expected": {"status": "SKIP_FIELD_CONTAINER_TOO_LARGE"}
    },
    {
      "id": "reject-frame-span-over-target",
      "audio_block_bit_lengths": [32768, 0, 0, 0, 0, 0],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 0, "payload_bytes": 1}
      ],
      "expected": {"status": "FRAME_SPAN_EXCEEDS_TARGET"}
    },
    {
      "id": "reject-frame-span-arithmetic-overflow",
      "audio_block_bit_lengths": [4294967295, 0, 0, 0, 0, 0],
      "skip_fields": [
        {"block_index": 2, "insertion_offset_bits": 0, "payload_bytes": 1}
      ],
      "expected": {"status": "BIT_SPAN_OVERFLOW"}
    }
  ]
}
