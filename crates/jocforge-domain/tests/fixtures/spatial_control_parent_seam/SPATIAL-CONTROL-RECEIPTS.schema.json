{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial-control-receipts.v1",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spatial_control_receipt": {
      "type": "object",
      "required": ["schema", "callback", "generation", "phase", "programme_sha256", "input_sha256", "config_sha256", "before_state_sha256", "installed48", "selector", "u04", "outer", "matrix", "destinations", "markers", "writer_set", "targets", "proposed_after_state_sha256", "commit_authority"],
      "properties": {
        "schema": {"const": "spatial-control-receipt.v1"},
        "installed48": {"type": "object", "required": ["shape", "bytes_sha256", "material_ref"]},
        "matrix": {"type": "object", "required": ["shape", "bytes_sha256", "material_ref"]},
        "destinations": {"type": "array", "minItems": 15, "maxItems": 15},
        "markers": {"type": "array", "minItems": 15, "maxItems": 15},
        "targets": {"type": "object", "required": ["previous_sha256", "current_sha256", "active_sha256", "transition_receipt_sha256"]},
        "commit_authority": {"const": "ENCLOSING_CALLBACK_TRANSACTION_ONCE"}
      }
    },
    "spatial_audio_proposal": {
      "type": "object",
      "required": ["schema", "callback", "generation", "spatial_control_receipt_sha256", "installed48_sha256", "matrix_sha256", "destinations_sha256", "targets_sha256", "f04_before_token", "receiver_qmf_mutated"],
      "properties": {"schema": {"const": "spatial-audio-proposal.v1"}, "receiver_qmf_mutated": {"const": false}}
    }
  },
  "production_schema_status": "BLOCKED_UNTIL_REAL_ADM_COLD_STATE_AND_CALLBACK"
}
