  "cases": [
    {
      "id": "class_drift",
      "input_mutation": "root.class=F04CompositionStatx",
      "expected": {
        "reject": true,
        "reason": "SCHEMA_CLASS"
      }
    },
    {
      "id": "field_name_drift",
      "input_mutation": "root.fields[0].name=callback_indey",
      "expected": {
        "reject": true,
        "reason": "DECLARED_FIELD_ORDER_OR_NAME"
      }
    },
    {
      "id": "field_order_drift",
      "input_mutation": "swap root fields0,1",
      "expected": {
        "reject": true,
        "reason": "DECLARED_FIELD_ORDER_OR_NAME"
      }
    },
    {
      "id": "field_count_drift",
      "input_mutation": "remove final receiver_callback_count field and update declared count",
      "expected": {
        "reject": true,
        "reason": "DECLARED_FIELD_COUNT"
      }
    },
    {
      "id": "temporal_indices_swapped",
      "input_mutation": "temporal0 index_28=0,index_32=1217",
      "expected": {
        "reject": true,
        "reason": "COLD_SCALAR_VALUE"
      }
    },
    {
      "id": "buffer_length_drift",
      "input_mutation": "temporal0 buffer0 length9735 instead9736",
      "expected": {
        "reject": true,
        "reason": "COLD_BUFFER_EXTENT"
      }
    },
    {
      "id": "None_to_int_zero",
      "input_mutation": "lfe.rows[0]=I(0)",
      "expected": {
        "reject": true,
        "reason": "COLD_NODE_TYPE"
      }
    },
    {
      "id": "None_to_zero_PCM",
      "input_mutation": "lfe.rows[0]=B6144 zero bytes",
      "expected": {
        "reject": true,
        "reason": "COLD_NODE_TYPE"
      }
    },
    {
      "id": "bool_to_int_zero",
      "input_mutation": "retired=I(0), not Z(false)",
      "expected": {
        "reject": true,
        "reason": "COLD_NODE_TYPE"
      }
    },
    {
      "id": "negative_zero_F32",
      "input_mutation": "peak=F(negative zero)",
      "expected": {
        "reject": true,
        "reason": "COLD_F32_BITS"
      }
    },
    {
      "id": "F32_endian_drift",
      "input_mutation": "previous_gain F32 payload bytes reversed",
      "expected": {
        "reject": true,
        "reason": "COLD_F32_BITS"
      }
    },
    {
      "id": "I64_endian_drift",
      "input_mutation": "temporal0 span I64 bytes reversed",
      "expected": {
        "reject": true,
        "reason": "COLD_SCALAR_VALUE"
      }
    },
    {
      "id": "class_length_endian_drift",
      "input_mutation": "root class U16 length bytes reversed",
      "expected": {
        "reject": true,
        "reason": "TRAILING_BYTES"
      }
    },
    {
      "id": "trailing_padding",
      "input_mutation": "append zero byte",
      "expected": {
        "reject": true,
        "reason": "TRAILING_BYTES"
      }
    },
    {
      "id": "truncated_root",
      "input_mutation": "remove final byte",
      "expected": {
        "reject": true,
        "reason": "TRUNCATED"
      }
    }
  ],
  "expected_role": "binary KAT files are post-serialization assertions; never load them as production state seeds"
}
