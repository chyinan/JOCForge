  "negative_cases": [
    {
      "id": "stale_callback_generation",
      "mutation": "receipt.g = consumer.g - 1",
      "expected_error": "READER_TARGET_RECEIPT_STALE"
    },
    {
      "id": "wrong_reader_invocation",
      "mutation": "receipt.q != receipt.g - 2",
      "expected_error": "READER_TARGET_RECEIPT_INVOCATION"
    },
    {
      "id": "wrong_programme",
      "mutation": "programme_id mismatch",
      "expected_error": "READER_TARGET_RECEIPT_LINEAGE"
    },
    {
      "id": "wrong_attempt",
      "mutation": "attempt_id mismatch",
      "expected_error": "READER_TARGET_RECEIPT_LINEAGE"
    },
    {
      "id": "wrong_transaction",
      "mutation": "transaction_id mismatch",
      "expected_error": "READER_TARGET_RECEIPT_LINEAGE"
    },
    {
      "id": "wrong_profile",
      "mutation": "profile_id mismatch",
      "expected_error": "READER_TARGET_RECEIPT_PROFILE"
    },
    {
      "id": "wrong_shape",
      "mutation": "target_shape != [16,6]",
      "expected_error": "READER_TARGET_PAYLOAD_SHAPE"
    },
    {
      "id": "wrong_byte_count",
      "mutation": "target_bytes != 384",
      "expected_error": "READER_TARGET_PAYLOAD_SIZE"
    },
    {
      "id": "nonfinite_target",
      "mutation": "replace one F32 word with NaN",
      "expected_error": "READER_TARGET_PAYLOAD_NONFINITE"
    },
    {
      "id": "payload_hash_mismatch",
      "mutation": "flip payload bit without updating hash",
      "expected_error": "READER_TARGET_PAYLOAD_HASH"
    },
    {
      "id": "reader_hash_mismatch",
      "mutation": "wrong reader_records_sha256",
      "expected_error": "READER_TARGET_READER_HASH"
    },
    {
      "id": "history_generation_mismatch",
      "mutation": "change one of 16 history producer generations",
      "expected_error": "READER_TARGET_HISTORY_LINEAGE"
    },
    {
      "id": "state_after_mismatch",
      "mutation": "wrong state_after_sha256",
      "expected_error": "READER_TARGET_STATE_LINEAGE"
    },
    {
      "id": "consumer_f04c_wrong_generation",
      "mutation": "F04C g differs from receipt g",
      "expected_error": "READER_TARGET_RECEIPT_STALE"
    },
    {
      "id": "consumer_f05jc_wrong_generation",
      "mutation": "F05JC g differs from receipt g",
      "expected_error": "READER_TARGET_RECEIPT_STALE"
    }
  ],
  "failure_atomicity": "no receipt; no target payload; no next-state proposal; no commit; I03 STAGE_FATAL and RETIRED"
}
